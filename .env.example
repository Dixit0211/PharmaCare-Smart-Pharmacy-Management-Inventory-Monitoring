# Application Environment Configuration
APP_NAME=PharmaCare
APP_ENV=development
SECRET_KEY=pharmacare-super-secret-key-change-in-production-2026

# Database Connection (Default: local SQLite database file)
DATABASE_URL=sqlite:///./data/pharmacare.db

# Security & Session Settings
SESSION_EXPIRE_MINUTES=480
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Business Rule Defaults
EXPIRY_ALERT_DAYS_DEFAULT=30
MIN_STOCK_THRESHOLD_DEFAULT=15
DEFAULT_TAX_RATE=5.0
DEFAULT_INVOICE_PREFIX=INV-PHARMA

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/pharmacare.log
